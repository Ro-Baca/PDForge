# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Output files generated by PDForge tools (keep git clean)
output/*
!output/.gitkeep

# Temporary test data (if you don't want test outputs committed)
*.tmp
*.temp

# Virtual environments (in case someone creates one locally)
.venv/
venv/
env/
ENV/

# Distribution / PyInstaller build artifacts (when packaging)
build/
dist/
*.spec

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*~

# Operating System files
.DS_Store
Thumbs.db